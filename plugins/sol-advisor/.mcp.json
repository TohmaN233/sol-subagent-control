{
  "mcpServers": {
    "sol-control-plane": {
      "command": "node",
      "args": [
        "./control-plane/server.mjs"
      ],
      "cwd": ".",
      "enabled": true,
      "env_vars": [
        "CODEX_HOME",
        "HOME",
        "USERPROFILE",
        "LOCALAPPDATA",
        "PATH"
      ],
      "default_tools_approval_mode": "approve"
    }
  }
}
